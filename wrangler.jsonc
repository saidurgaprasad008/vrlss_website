{
  "name": "vrlss-website",
  "compatibility_date": "2026-10-01",
  // The small server for /api/* (blog posts + testimonials). Everything else is the static site in ./dist.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vrlss",
      // Paste the id printed by:  npx wrangler d1 create vrlss
      "database_id": "d7414110-b08d-4d47-91d1-e4f33aff302e"
    }
  ]
}
